/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' https://alist.tlljyang.pp.ua wss://alist.tlljyang.pp.ua; manifest-src 'self'; upgrade-insecure-requests

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/runtime/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/runtime/runtime-manifest.json
  Cache-Control: public, max-age=0, must-revalidate

# webR's worker compiles R to WebAssembly and evaluates JS shims through
# Emscripten's eval() during R startup; without 'unsafe-eval' the worker dies
# silently and the R studio spins until its 150s init timeout. This relaxed
# policy rides on webr-worker.js, so it governs only the worker scope, never
# the portal document. Accept-Ranges lets Emscripten's LazyFiles range-chunk
# the vfs archives instead of force-downloading each whole file.
/runtime/webr/*
  Content-Security-Policy: script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval'; connect-src 'self'
  Accept-Ranges: bytes

/brand/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/*.wasm
  Content-Type: application/wasm
