{
  "name": "zujuan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:runtime-config": "node scripts/generate-runtime-config.mjs",
    "generate:reviewed-index": "node scripts/generate-reviewed-index.mjs",
    "generate": "npm run generate:runtime-config && npm run generate:reviewed-index",
    "predev": "npm run generate",
    "dev": "next dev --webpack -p 3200",
    "prebuild": "npm run generate",
    "build": "next build --webpack",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare deploy",
    "upload:cloudflare": "opennextjs-cloudflare upload",
    "start": "next start -p 3200",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run generate && node --experimental-strip-types --test tests/*.test.mjs && node scripts/test-api-auth.mjs",
    "test:build-artifacts": "node scripts/test-build-artifacts.mjs",
    "db:bootstrap": "node scripts/bootstrap-database.mjs"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "js-yaml": "^5.4.1",
    "jszip": "^3.10.1",
    "katex": "^0.18.5",
    "lucide-react": "^1.38.0",
    "mammoth": "^1.12.2",
    "next": "^16.3.3",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.127.1"
  }
