# Bootstrap-only administrator credential. Do not configure this in the Worker.
STAT_DB_ADMIN_PASSWORD=replace-with-database-admin-secret

# Runtime application-role credential.
STAT_DB_PASSWORD=replace-with-application-secret

# Use three different temporary passwords. Every account must change its own
# password before any question-bank or AI API can be used.
STAT_INITIAL_SUDO_PASSWORD=replace-with-unique-sudo-password
STAT_INITIAL_TEACHER_PASSWORD=replace-with-unique-teacher-password
STAT_INITIAL_STUDENT_PASSWORD=replace-with-unique-student-password
